# ClusterAxe — Gamma (601) Master variant overrides.
# Layered on top of sdkconfig.defaults via SDKCONFIG_DEFAULTS in build_master.bat.
# IDF reads this (never rewrites it); the generated sdkconfig lands in build_master/.
CONFIG_CLUSTER_MODE_MASTER=y
# CONFIG_CLUSTER_MODE_SLAVE is not set
CONFIG_CLUSTER_MAX_SLAVES=8
CONFIG_CLUSTER_WORK_QUEUE_SIZE=4
CONFIG_CLUSTER_SHARE_QUEUE_SIZE=16
CONFIG_CLUSTER_HEARTBEAT_MS=3000
CONFIG_CLUSTER_TIMEOUT_MS=10000
CONFIG_CLUSTER_DEBUG_LOGGING=n
CONFIG_CLUSTER_STATS_ENABLED=y
CONFIG_CLUSTER_WEB_API_ENABLED=y
# CONFIG_CLUSTER_TRANSPORT_BAP is not set
CONFIG_CLUSTER_TRANSPORT_ESPNOW=y
# CONFIG_CLUSTER_TRANSPORT_BOTH is not set
CONFIG_CLUSTER_ESPNOW_CHANNEL=1
# CONFIG_CLUSTER_ESPNOW_ENCRYPT is not set
CONFIG_CLUSTER_ESPNOW_DISCOVERY_INTERVAL_MS=1000
CONFIG_CLUSTER_ESPNOW_AUTO_PAIR=y
